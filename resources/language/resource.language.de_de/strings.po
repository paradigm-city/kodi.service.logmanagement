# Kodi Media Center language file
# Addon Name: Log Management
# Addon id: service.logmanagement
# Addon Provider: paradigm_city
msgid ""
msgstr ""
"Project-Id-Version: service.logmanagement\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: de_DE\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgctxt "#30000"
msgid "General"
msgstr "Allgemein"

msgctxt "#30001"
msgid "Rotation"
msgstr "Rotation"

msgctxt "#30002"
msgid "Rotate automatically"
msgstr "Automatisch rotieren"

msgctxt "#30003"
msgid "Rotate kodi.log automatically when it exceeds the size or age limit."
msgstr "kodi.log automatisch rotieren, wenn die Größen- oder Altersgrenze überschritten wird."

msgctxt "#30004"
msgid "Maximum log size"
msgstr "Maximale Loggröße"

msgctxt "#30005"
msgid "Rotate the log once it reaches this size."
msgstr "Das Log rotieren, sobald es diese Größe erreicht."

msgctxt "#30006"
msgid "Maximum log age"
msgstr "Maximales Logalter"

msgctxt "#30007"
msgid "Rotate the log after this many hours, counted from Kodi start or the last rotation."
msgstr "Das Log nach so vielen Stunden rotieren, gezählt ab Kodi-Start oder der letzten Rotation."

msgctxt "#30008"
msgid "Check interval"
msgstr "Prüfintervall"

msgctxt "#30009"
msgid "How often the log size and age are checked."
msgstr "Wie oft Größe und Alter des Logs geprüft werden."

msgctxt "#30010"
msgid "Archives"
msgstr "Archive"

msgctxt "#30011"
msgid "Number of archives to keep"
msgstr "Anzahl aufzubewahrender Archive"

msgctxt "#30012"
msgid "Rotated logs are named kodi.1.log (newest) to kodi.N.log (oldest). Older ones are deleted, except those needed to restore the log of the current Kodi session."
msgstr "Rotierte Logs heißen kodi.1.log (neuestes) bis kodi.N.log (ältestes). Ältere werden gelöscht, außer denen, die zum Wiederherstellen des Logs der aktuellen Kodi-Sitzung nötig sind."

msgctxt "#30013"
msgid "Compress archives"
msgstr "Archive komprimieren"

msgctxt "#30014"
msgid "Store rotated logs gzip-compressed (kodi.1.log.gz)."
msgstr "Rotierte Logs gzip-komprimiert speichern (kodi.1.log.gz)."

msgctxt "#30020"
msgid "Miscellaneous"
msgstr "Sonstiges"

msgctxt "#30021"
msgid "Show notification on rotation"
msgstr "Bei Rotation benachrichtigen"

msgctxt "#30022"
msgid "Show a notification whenever the log is rotated automatically."
msgstr "Eine Benachrichtigung anzeigen, wenn das Log automatisch rotiert wird."

msgctxt "#30023"
msgid "Rotate now"
msgstr "Jetzt rotieren"

msgctxt "#30024"
msgid "Rotate the log immediately."
msgstr "Das Log sofort rotieren."

msgctxt "#30025"
msgid "Export log"
msgstr "Log exportieren"

msgctxt "#30026"
msgid "Save the complete log of the current Kodi session (archived parts plus current log) as one file, e.g. for support requests. The folder is chosen when exporting."
msgstr "Das vollständige Log der aktuellen Kodi-Sitzung (archivierte Teile plus aktuelles Log) als eine Datei speichern, z. B. für Support-Anfragen. Der Ordner wird beim Exportieren gewählt."

msgctxt "#30030"
msgid "Support"
msgstr "Support"

msgctxt "#30031"
msgid "Suspend rotation until Kodi restarts"
msgstr "Rotation bis zum Kodi-Neustart aussetzen"

msgctxt "#30032"
msgid "Keep kodi.log in one piece for the rest of this Kodi session, e.g. to produce a classic debug log for a support request. Ends automatically when Kodi restarts."
msgstr "kodi.log für den Rest dieser Kodi-Sitzung am Stück lassen, z. B. um ein klassisches Debug-Log für eine Support-Anfrage zu erzeugen. Endet automatisch beim Neustart von Kodi."

msgctxt "#30100"
msgid "{0:d} MB"
msgstr "{0:d} MB"

msgctxt "#30101"
msgid "{0:d} h"
msgstr "{0:d} Std."

msgctxt "#30102"
msgid "{0:d} min"
msgstr "{0:d} Min."

msgctxt "#30103"
msgid "Disabled"
msgstr "Deaktiviert"

msgctxt "#30200"
msgid "Log rotated to {0}"
msgstr "Log rotiert nach {0}"

msgctxt "#30201"
msgid "Log rotation failed, see kodi.log"
msgstr "Log-Rotation fehlgeschlagen, siehe kodi.log"

msgctxt "#30202"
msgid "Log is empty, nothing to rotate"
msgstr "Log ist leer, nichts zu rotieren"

msgctxt "#30210"
msgid "Choose export folder"
msgstr "Exportordner wählen"

msgctxt "#30211"
msgid "Log exported to {0}"
msgstr "Log exportiert nach {0}"

msgctxt "#30212"
msgid "Log exported, but the start of the session was not found. It may be incomplete."
msgstr "Log exportiert, aber der Beginn der Sitzung wurde nicht gefunden. Es ist möglicherweise unvollständig."

msgctxt "#30213"
msgid "Log export failed, see kodi.log"
msgstr "Log-Export fehlgeschlagen, siehe kodi.log"

msgctxt "#30220"
msgid "Rotation suspended until Kodi restarts"
msgstr "Rotation bis zum Kodi-Neustart ausgesetzt"

msgctxt "#30221"
msgid "Rotation suspended, but kodi.log no longer contains the start of this session. Use Export log for the complete log."
msgstr "Rotation ausgesetzt, aber kodi.log enthält den Beginn dieser Sitzung nicht mehr. Für das vollständige Log „Log exportieren“ verwenden."

msgctxt "#30222"
msgid "Rotation resumed"
msgstr "Rotation fortgesetzt"
