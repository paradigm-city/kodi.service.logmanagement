<?xml version="1.0" encoding="utf-8" ?>
<settings version="1">
    <section id="service.logmanagement">
        <category id="general" label="30000">
            <group id="rotation" label="30001">
                <setting id="enabled" type="boolean" label="30002" help="30003">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
                <setting id="max_size_mb" type="integer" label="30004" help="30005">
                    <level>0</level>
                    <default>20</default>
                    <constraints>
                        <minimum>0</minimum>
                        <step>5</step>
                        <maximum>500</maximum>
                    </constraints>
                    <dependencies>
                        <dependency type="enable" setting="enabled">true</dependency>
                    </dependencies>
                    <control type="spinner" format="string">
                        <formatlabel>30100</formatlabel>
                        <minimumlabel>30103</minimumlabel>
                    </control>
                </setting>
                <setting id="max_age_hours" type="integer" label="30006" help="30007">
                    <level>0</level>
                    <default>0</default>
                    <constraints>
                        <minimum>0</minimum>
                        <step>1</step>
                        <maximum>168</maximum>
                    </constraints>
                    <dependencies>
                        <dependency type="enable" setting="enabled">true</dependency>
                    </dependencies>
                    <control type="spinner" format="string">
                        <formatlabel>30101</formatlabel>
                        <minimumlabel>30103</minimumlabel>
                    </control>
                </setting>
                <setting id="check_interval_min" type="integer" label="30008" help="30009">
                    <level>1</level>
                    <default>5</default>
                    <constraints>
                        <minimum>1</minimum>
                        <step>1</step>
                        <maximum>60</maximum>
                    </constraints>
                    <dependencies>
                        <dependency type="enable" setting="enabled">true</dependency>
                    </dependencies>
                    <control type="spinner" format="string">
                        <formatlabel>30102</formatlabel>
                    </control>
                </setting>
            </group>
            <group id="archives" label="30010">
                <setting id="keep" type="integer" label="30011" help="30012">
                    <level>0</level>
                    <default>5</default>
                    <constraints>
                        <minimum>1</minimum>
                        <step>1</step>
                        <maximum>50</maximum>
                    </constraints>
                    <control type="spinner" format="integer"/>
                </setting>
                <setting id="compress" type="boolean" label="30013" help="30014">
                    <level>0</level>
                    <default>true</default>
                    <control type="toggle"/>
                </setting>
            </group>
            <group id="misc" label="30020">
                <setting id="notify" type="boolean" label="30021" help="30022">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
                <setting id="rotate_now" type="action" label="30023" help="30024">
                    <level>0</level>
                    <data>NotifyAll(service.logmanagement,rotate)</data>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <dependencies>
                        <dependency type="enable" setting="suspended">false</dependency>
                    </dependencies>
                    <control type="button" format="action">
                        <close>false</close>
                    </control>
                </setting>
            </group>
            <group id="support" label="30030">
                <setting id="suspended" type="boolean" label="30031" help="30032">
                    <level>0</level>
                    <default>false</default>
                    <control type="toggle"/>
                </setting>
                <setting id="export_log" type="action" label="30025" help="30026">
                    <level>0</level>
                    <data>NotifyAll(service.logmanagement,export)</data>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="button" format="action">
                        <close>true</close>
                    </control>
                </setting>
            </group>
        </category>
    </section>
</settings>
